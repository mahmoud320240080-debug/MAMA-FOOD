# Copy to .env (or .env.local) and adjust. All variables are optional.
# Vite embeds VITE_* values into the bundle at BUILD time: never put secrets here,
# and set them in the hosting dashboard (Netlify / Vercel) before building.

# Data source. Anything except "false" = demo mode: mock data stored in the browser's localStorage.
# "false" = call the real backend at VITE_API_URL.
VITE_USE_MOCK=true

# Backend base URL, used only when VITE_USE_MOCK=false (no trailing slash).
VITE_API_URL=https://api.example.com

# Restaurant WhatsApp number for the "send order on WhatsApp" link:
# international format, digits only, no "+" (Egypt: 20 + mobile without the leading 0).
VITE_WHATSAPP_NUMBER=201000000000
